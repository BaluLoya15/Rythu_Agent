# Rythu Agent Configuration
# For BharatAgentic Hackathon

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM Configuration (Optional: The agent features a deterministic agricultural reasoning synthesizer for 100% offline demo reliability)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API (Optional: Free Open-Meteo or IMD Demo fallback automatically used)
OPENWEATHERMAP_API_KEY=

# Default Demo Settings
FORCE_DEMO_MODE=true
DEFAULT_FARMER_ID=farmer-001
